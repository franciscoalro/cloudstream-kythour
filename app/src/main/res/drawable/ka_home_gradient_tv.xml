<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Horizontal veil keeps metadata readable without hiding the artwork. -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#F2090B10"
                android:centerColor="#A6090B10"
                android:endColor="#00090B10"
                android:centerX="0.46" />
        </shape>
    </item>
    <!-- Bottom fade visually connects the hero to the content rails. -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#E6090B10"
                android:centerColor="#26090B10"
                android:endColor="#00090B10"
                android:centerY="0.38" />
        </shape>
    </item>
</layer-list>
